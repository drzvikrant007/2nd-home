rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin'
      );
    }

    // Helper function to check if user is authenticated (including anonymous)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Menu: Public to read, admin-only to write
    match /menu/{menuId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site Config: Public to read, admin-only to write
    match /config/site {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders:
    // - Any authenticated anonymous user can create an order
    // - Customer can read their own order (matched by customerUid or orderId)
    // - Admin can read and update all orders (e.g. stage, rider assignment, status)
    match /orders/{orderId} {
      allow create: if isAuthenticated() && request.resource.data.customerUid == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.customerUid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
